{
	"name": "obsidian-ghostty",
	"version": "1.0.0",
	"description": "Ghostty terminal integration for Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"ghostty",
		"terminal"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.13.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.25.0",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "5.7.3"
	},
	"dependencies": {
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/addon-web-links": "^0.11.0",
		"@xterm/xterm": "^5.5.0",
		"node-pty": "^1.0.0"
	}
}
